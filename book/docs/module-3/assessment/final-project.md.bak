        """

        # Save report to file
        report_path = os.path.join(self.documentation_path, "technical_report.md")
        with open(report_path, 'w') as f:
            f.write(report_content)

        print(f"Technical report saved to: {report_path}")
        return report_path

    def _format_project_summary(self, summary):
        """Format project summary for report"""

        if isinstance(summary, dict):
            formatted = ""
            for key, value in summary.items():
                if isinstance(value, dict):
                    formatted += f"### {key}\n"
                    for subkey, subvalue in value.items():
                        formatted += f"- {subkey}: {subvalue}\n"
                    formatted += "\n"
                else:
                    formatted += f"- {key}: {value}\n"
            return formatted
        else:
            return str(summary)

    def _format_performance_results(self, results):
        """Format performance results for report"""

        if isinstance(results, dict):
            formatted = ""
            for key, value in results.items():
                formatted += f"- {key}: {value}\n"
            return formatted
        else:
            return str(results)

    def _format_test_results(self, results):
        """Format test results for report"""

        if isinstance(results, dict):
            formatted = ""
            for test_name, result in results.items():
                status = "✅ PASS" if result is True else ("❌ FAIL" if result is False else f"⚠️ {result}")
                formatted += f"- {test_name}: {status}\n"
            return formatted
        else:
            return str(results)

    def generate_implementation_guide(self, project_components):
