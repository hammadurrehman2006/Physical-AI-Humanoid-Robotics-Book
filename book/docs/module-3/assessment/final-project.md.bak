### Step 5: Performance Optimization and Testing

```python
#!/usr/bin/env python3
"""
Step 5: Performance optimization and testing for the project
"""
import time
import psutil
import GPUtil
from collections import deque

class PerformanceOptimizer:
    """Optimize performance and run tests for the project"""

    def __init__(self, world, project_components):
        self.world = world
        self.project_components = project_components
        self.performance_metrics = {
            'fps': deque(maxlen=100),
            'physics_steps_per_sec': deque(maxlen=100),
            'memory_usage': deque(maxlen=100),
            'cpu_load': deque(maxlen=100)
        }

    def optimize_simulation_performance(self):
        """Optimize simulation performance"""

        print("Optimizing simulation performance...")

        # Physics optimizations
        physics_context = self.world.scene.get_physics_context()
        physics_context.set_position_iteration_count(4)  # Reduced for performance
        physics_context.set_velocity_iteration_count(2)  # Reduced for performance

        # Enable stabilization for better performance
        physics_context.enable_stabilization()

        # Memory optimizations
        torch.backends.cudnn.benchmark = True  # Optimize for consistent input sizes

        print("Simulation performance optimized")

    def run_performance_tests(self, duration=10.0):
        """Run performance tests for the specified duration"""

        print(f"Running performance tests for {duration} seconds...")

        start_time = time.time()
        step_count = 0
        last_time = start_time

        while time.time() - start_time < duration:
            # Step simulation
            self.world.step(render=True)
            step_count += 1

            # Record metrics
            current_time = time.time()
            elapsed = current_time - last_time
            if elapsed > 0:
                fps = 1.0 / elapsed
                self.performance_metrics['fps'].append(fps)

            # Record system metrics
            self.performance_metrics['cpu_load'].append(psutil.cpu_percent())
            self.performance_metrics['memory_usage'].append(psutil.virtual_memory().percent)

            last_time = current_time

        total_time = time.time() - start_time
        avg_fps = step_count / total_time if total_time > 0 else 0
        avg_cpu = sum(self.performance_metrics['cpu_load']) / len(self.performance_metrics['cpu_load']) if self.performance_metrics['cpu_load'] else 0
        avg_memory = sum(self.performance_metrics['memory_usage']) / len(self.performance_metrics['memory_usage']) if self.performance_metrics['memory_usage'] else 0

        print(f"Performance test results:")
        print(f"  - Average FPS: {avg_fps:.2f}")
        print(f"  - Average CPU: {avg_cpu:.1f}%")
        print(f"  - Average Memory: {avg_memory:.1f}%")
        print(f"  - Total steps: {step_count}")

        return {
            'avg_fps': avg_fps,
            'avg_cpu': avg_cpu,
            'avg_memory': avg_memory,
            'total_steps': step_count
        }

    def run_functional_tests(self):
        """Run functional tests to verify all components work together"""

        print("Running functional tests...")

        test_results = {}

        # Test 1: Robot control
        try:
            robot = self.project_components['robot']
            initial_pos = robot.get_world_positions()

            # Apply a small control action
            current_pos = robot.get_joint_positions()
            new_pos = current_pos + torch.ones_like(current_pos) * 0.01
            robot.set_joint_positions(new_pos)

            # Step simulation
            self.world.step(render=True)

            final_pos = robot.get_world_positions()

            # Check if robot moved
            movement = torch.norm(final_pos - initial_pos)
            test_results['robot_control'] = movement.item() > 0.001

        except Exception as e:
            test_results['robot_control'] = f"Error: {e}"

        # Test 2: Sensor data collection
        try:
            sensors = self.project_components['sensors']
            sensor_data_collected = False

            # Step to update sensors
            self.world.step(render=True)

            # Try to get data from each sensor
            for sensor_name, sensor in sensors.items():
                if sensor_name == "camera":
                    try:
                        data = sensor.get_rgb()
                        sensor_data_collected = data is not None
                        break
                    except:
                        continue

            test_results['sensor_functionality'] = sensor_data_collected

        except Exception as e:
            test_results['sensor_functionality'] = f"Error: {e}"

        # Test 3: Physics stability
        try:
            robot_pos = robot.get_world_positions()
            robot_orientation = robot.get_world_quat()

            # Check if robot is in reasonable position
            height_ok = robot_pos[0, 2] > 0.3  # Should be above ground
            orientation_ok = torch.abs(robot_orientation[0, 3]) > 0.5  # Should be somewhat upright

            test_results['physics_stability'] = height_ok and orientation_ok

        except Exception as e:
            test_results['physics_stability'] = f"Error: {e}"

        print(f"Functional test results: {test_results}")
        return test_results

    def optimize_memory_usage(self):
        """Optimize memory usage"""

        print("Optimizing memory usage...")

        # Clear any cached data
        torch.cuda.empty_cache() if torch.cuda.is_available() else None

        # Optimize tensor usage
        # Use appropriate data types
        # Implement data streaming where possible

        print("Memory optimization completed")

    def generate_performance_report(self):
        """Generate a comprehensive performance report"""

        print("Generating performance report...")

        # Collect final metrics
        final_metrics = {}
        for key, values in self.performance_metrics.items():
            if values:
                final_metrics[key] = {
                    'avg': sum(values) / len(values),
                    'min': min(values),
                    'max': max(values),
                    'count': len(values)
                }

        # System information
        system_info = {
            'cpu_count': psutil.cpu_count(),
            'memory_total': psutil.virtual_memory().total / (1024**3),  # GB
            'python_version': platform.python_version()
        }

        if torch.cuda.is_available():
            system_info['gpu'] = torch.cuda.get_device_name()
            system_info['gpu_memory'] = torch.cuda.get_device_properties(0).total_memory / (1024**3)  # GB

        report = {
            'performance_metrics': final_metrics,
            'system_info': system_info,
            'recommendations': self._generate_recommendations(final_metrics)
        }

        print("Performance report generated")
        return report

    def _generate_recommendations(self, metrics):
        """Generate performance recommendations"""

        recommendations = []

        if metrics.get('fps', {}).get('avg', 0) < 30:
            recommendations.append("FPS below target (30), consider reducing rendering quality or physics complexity")

        if metrics.get('cpu_load', {}).get('avg', 0) > 80:
            recommendations.append("High CPU usage, consider reducing environment complexity")

        if metrics.get('memory_usage', {}).get('avg', 0) > 85:
            recommendations.append("High memory usage, consider reducing batch sizes or using memory-efficient operations")

        return recommendations

def optimize_and_test_project(project):
    """Run performance optimization and testing for the project"""

    print("Running project optimization and testing...")

    # Prepare project components
    project_components = {
        'robot': project.robots['main'],
        'sensors': project.sensors,
        'world': project.world
    }

    # Create performance optimizer
    perf_optimizer = PerformanceOptimizer(project.world, project_components)

    # Optimize performance
    perf_optimizer.optimize_simulation_performance()
    perf_optimizer.optimize_memory_usage()

    # Run performance tests
    perf_results = perf_optimizer.run_performance_tests(duration=5.0)  # 5 seconds for quick test

    # Run functional tests
    func_results = perf_optimizer.run_functional_tests()

    # Generate performance report
    report = perf_optimizer.generate_performance_report()

    print(f"\nPerformance Results: {perf_results}")
    print(f"Functional Test Results: {func_results}")
    print(f"Performance Report: {report}")

    print("Project optimization and testing completed")
    return perf_optimizer, perf_results, func_results, report
```

