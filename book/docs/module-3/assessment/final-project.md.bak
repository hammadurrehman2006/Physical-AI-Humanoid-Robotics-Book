def document_project(project, performance_results, test_results):
    """Generate complete documentation for the project"""

    print("Generating complete project documentation...")

    # Create documentation instance
    doc_system = ProjectDocumentation()

    # Get project summary
    project_summary = project.get_setup_summary()

    # Generate technical report
    report_path = doc_system.generate_technical_report(
        project_summary,
        performance_results,
        test_results
    )

    # Generate implementation guide
    guide_path = doc_system.generate_implementation_guide(project)

    # Save project artifacts
    doc_system.save_project_artifacts(project, performance_results, test_results)

    print("Complete project documentation generated successfully")
    print(f"Technical Report: {report_path}")
    print(f"Implementation Guide: {guide_path}")

    return doc_system
